# Give the logged-in desktop user access to SteelSeries HID devices.
# Install to /etc/udev/rules.d/99-steelseries-hidraw.rules, then:
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=hidraw
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", MODE="0660", GROUP="input", TAG+="uaccess"
