{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arctis Control",
  "version": "0.1.0",
  "identifier": "dev.arctis.control",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Arctis Control",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
